# Proxy da Reunião CliqFast (baseado em docker/files/production/default.conf.template).
server {
    listen 8083;
    # Resolve backend e front a cada pedido (DNS do Docker): recriar um contêiner não deixa o proxy com o IP antigo (502).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $meet_backend http://${BACKEND_INTERNAL_HOST}:8000;
    set $meet_frontend http://${FRONTEND_INTERNAL_HOST}:8080;
    server_name localhost;
    charset utf-8;

    # Disables server version feedback on pages and in headers
    server_tokens off;

    proxy_ssl_server_name on;

    location @proxy_to_meet_backend {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # O túnel do Cloudflare chega em HTTP; o Django precisa saber que o visitante está em HTTPS.
        proxy_set_header X-Forwarded-Proto https;

        proxy_redirect off;
        proxy_pass $meet_backend;
    }

    location @proxy_to_meet_frontend {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_redirect off;
        proxy_pass $meet_frontend;
    }

    # Arquivos da marca sem hash no nome (CSS da casa, logo, ilustrações): validade curta, para o Cloudflare não segurar
    # a versão antiga por 30 dias depois de uma troca.
    location ~ ^/(assets/(cliqfast\.css|logo-cliqfast\.png|intro-slider/)|favicon|apple-touch-icon|android-chrome|acesso-negado\.html) {
        proxy_set_header Host $http_host;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "public, max-age=300" always;
        proxy_pass $meet_frontend;
    }

    location / {
        try_files $uri @proxy_to_meet_frontend;
    }

    location /api {
        try_files $uri @proxy_to_meet_backend;
    }

    location /admin {
        try_files $uri @proxy_to_meet_backend;
    }

    # API externa (aba Reuniões da CliqGestão cria as salas por aqui).
    location /external-api {
        try_files $uri @proxy_to_meet_backend;
    }

    location /static {
        try_files $uri @proxy_to_meet_backend;
    }
}