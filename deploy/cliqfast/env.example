# Modelo do ~/sandbox/meet/config/.env (o arquivo real fica só no servidor, fora do Git).
# Gerar: DJANGO_SECRET_KEY e DB_PASSWORD (python3 -c "import secrets; print(secrets.token_urlsafe(48))").

DJANGO_SETTINGS_MODULE=meet.settings
DJANGO_CONFIGURATION=Production
DJANGO_ALLOWED_HOSTS=reuniao.cliqfast.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://reuniao.cliqfast.com.br
DJANGO_SECRET_KEY=
DJANGO_LANGUAGE_CODE=pt-br
PYTHONPATH=/app
MEET_BASE_URL=https://reuniao.cliqfast.com.br

DB_HOST=postgresql
DB_NAME=meet
DB_USER=meet
DB_PASSWORD=
DB_PORT=5432
POSTGRES_DB=meet
POSTGRES_USER=meet
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/1

# Login: app SaaS (OIDC) do Cloudflare Access. <equipe>.cloudflareaccess.com e o client_id vêm do app.
OIDC_OP_AUTHORIZATION_ENDPOINT=https://<equipe>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client_id>/authorization
OIDC_OP_TOKEN_ENDPOINT=https://<equipe>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client_id>/token
OIDC_OP_USER_ENDPOINT=https://<equipe>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client_id>/userinfo
OIDC_OP_JWKS_ENDPOINT=https://<equipe>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client_id>/jwks
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile
LOGIN_REDIRECT_URL=https://reuniao.cliqfast.com.br
LOGIN_REDIRECT_URL_FAILURE=https://reuniao.cliqfast.com.br
LOGOUT_REDIRECT_URL=https://reuniao.cliqfast.com.br
OIDC_REDIRECT_ALLOWED_HOSTS=["https://reuniao.cliqfast.com.br"]

# Vídeo: projeto do LiveKit Cloud (URL https://<projeto>.livekit.cloud).
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ALLOW_UNREGISTERED_ROOMS=False

# API externa: a aba Reuniões da CliqGestão cria salas em nome de quem está logado.
EXTERNAL_API_ENABLED=True
FRONTEND_USE_FRENCH_GOV_FOOTER=False
FRONTEND_USE_PROCONNECT_BUTTON=False
